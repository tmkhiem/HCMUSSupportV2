  "ConnectionString": "Server=localhost;Database=HRM;Integrated Security=SSPI",
  "SqlQuery": "SELECT [NHANSU]\r\n, dm_cn.[TenChuyenNganh]\r\n,[MA]\r\n,[HODEM]\r\n,[TEN]\r\n,[DIENTHOAI]\r\n,[DIDONG]\r\n,[DIENTHOAI1]\r\n,[EMAIL]\r\n,[NGAYSINH]\r\n,[THANGSINH]\r\n,[NAMSINH]\r\n,[NOISINH]\r\n,[NGUYENQUAN]\r\n,[HoKhauThuongTru]\r\n,ns.[MaPhuongXa]\r\n,dm_px1.TenPhuongXa TenPhuongXa\r\n,[QUAN_HUYEN]\r\n, dm_qh1.TenQuanHuyen TenQuanHuyen\r\n,[TINH_THANHPHO]\r\n, dm_ttp1.TenTinhThanhPho TenTinhThanhPho\r\n\r\n,[DCLL]\r\n,[MaPhuongXa_LienLac]\r\n,dm_pxll.TenPhuongXa TenPhuongXaLienLac\r\n,[QUAN_HUYEN_LienLac]\r\n,dm_qhll.TenQuanHuyen TenQuanHuyenLienLac\r\n,[TINH_THANHPHO_LienLac]\r\n,dm_ttpll.TenTinhThanhPho TenTinhThanhPhoLienLac\r\n,[NGAYTHUVIEC]\r\n,[NGAYNGHIVIEC]\r\n,[NGAYTGCT]\r\n\r\n,IIF([GIOITINH]=1, N'Nam', N'Nữ') as [TENGIOITINH]\r\n,[SOCMND]\r\n,[NGAYCAP]\r\n,[NOICAP]\r\n\r\n\r\n,[DANTOC]\r\n,dm_dt.TenDanToc TenDanToc\r\n\r\n,[QUOCTICH]\r\n, dm_qt.TenQuocTich TenQuocTich\r\n\r\n,[TONGIAO]\r\n,dm_tg.TenTonGiao TenTonGiao\r\n\r\n,[HOCHAM]\r\n,dm_hh.TenHocHam TenHocHam\r\n\r\n,[HOCVI]\r\n,dm_hv.TenHocVi TenHocVi\r\n\r\n,[DONVI]\r\n,dm_dv.TENDONVI TenDonVi\r\n\r\n,[PHONGBAN]\r\n,dm_pb.TENPHONGBAN TenPhongBan\r\n\r\n\r\n,[TRINHDOHOCVAN]\r\n,dm_tdhv.TenTrinhDoHocVan TenTrinhDoHocVan\r\n\r\n\r\n,[NAMHV]\r\n,[NOIHV]\r\n,[CHUYENNGANH]\r\n,[CHINHTRI]\r\n,dm_ct.TenChinhTri TenChinhTri\r\n,[NAMCHINHTRI]\r\n,[QLHCNN]\r\n,[PHANHE]\r\n,[LAPGIADINH]\r\n,[TP_GIADINH]\r\n,[TP_BANTHAN]\r\n,[NVQUANSU]\r\n,[HSNS]\r\n,[SLD]\r\n,[BHXH]\r\n,[THAMGIABHXH]\r\n,[DANGVIEN]\r\n,IIF([DANGVIEN]=1, N'Đảng viên', N'') as [DANGVIENTEXT]\r\n,[HSDANG]\r\n,[THEDANG]\r\n,[NGAYVAODANG]\r\n,[DOANVIEN]\r\n,IIF([DOANVIEN]=1, N'Đoàn viên', N'') as [DOANVIENTEXT]\r\n,[HSDOAN]\r\n,[THEDOAN]\r\n,[GIAOVIEN]\r\n,[THECONGDOAN]\r\n,[BHYT]\r\n,[DKKCB]\r\n,[NGUON_NHANSU]\r\n,[NgayDeleted]\r\n,[TINHTRANG]\r\n,[SOTAIKHOAN]\r\n,[CHUCVU]\r\n,dm_cv.TenChucVu TenChucVu\r\n,[NGOAINGU]\r\n,[CHINHSACH]\r\n,[SOHIEUQNCN]\r\n,[NGAYNHAPNGU]\r\n,[NGAYXUATNGU]\r\n,[NGAYVAODOAN]\r\n,[NOIVAODOAN]\r\n,[NOIVAODANG]\r\n,[CAPBAC]\r\n,[NAMCAPBAC]\r\n,[NGUOIDUNG2]\r\n,[NGAY2]\r\n,[MAY2]\r\n,[NGUOIDUNG1]\r\n,[NGAY1]\r\n,[MST]\r\n,[MAY1]\r\n\r\n,[Hinh]\r\n,[Del]\r\n,[NGANHANG]\r\n,dm_nh.TenNganHang TenNganHang\r\n,[COSO]\r\n,[Ngach_CongChuc]\r\n,[BacCongChuc]\r\n,[HeSoLuong]\r\n,[PhanTramVuotKhung]\r\n,[PhuCapQLKhoa]\r\n,[PhuCapTrachNhiem]\r\n,[PhuCapDocHai]\r\n,[LuongHDKhoan]\r\n,[KhoanTuNgay]\r\n,[KhoanDenNgay]\r\n,[DuHocTuNgay]\r\n,[DuHocDenNgay]\r\n,[TINHOC]\r\n,[GHICHU]\r\n,[bHDKhoanBienChe]\r\n,[NgayHuongLuong]\r\n,[NganHangChiNhanh]\r\n,[PhanTramUuDai]\r\n,[PhanTramThamNienGD]\r\n,[SortOrder]\r\n,[SoHopDong]\r\n,[NgayHetHanHopDong]\r\n,[IsGiamTruGiaCanh]\r\n,[IsTuQuyetToanThueNam]\r\n,[IsNgungCongTac]\r\n,[IsKiemNhiemPTNK]\r\n,[PhuCapTrachNhiem2]\r\n,[PhuCapTrachNhiem3]\r\n,[PhuCapTrachNhiem4]\r\n,[PhuCapTrachNhiem5]\r\n,[HeSoChucVuPTNK]\r\n,[HeSoPhuCapPTNK]\r\n,[NoiDungTrachNhiem2]\r\n,[NoiDungTrachNhiem3]\r\n,[NoiDungTrachNhiem4]\r\n,[NoiDungTrachNhiem5]\r\n,[LuongHDKhoan_NgoaiGio]\r\n,[KhoanTuNgay_NgoaiGio]\r\n,[KhoanDenNgay_NgoaiGio]\r\n,[NoiDungKhoanNgoaiGio]\r\n,[IsCamKetKhongTinhThue]\r\n,[HeSoLuongKiemNhiem]\r\n,[NghiThaiSanTuNgay]\r\n,[NghiThaiSanDenNgay]\r\n,[IsKhongCuTru]\r\n,[PhuCapQLKhoa2]\r\n,[PhuCapQLKhoa3]\r\n,[PhuCapQLKhoa4]\r\n,[PhuCapQLKhoa5]\r\n,[NoiDungPhuCapQLKhoa2]\r\n,[NoiDungPhuCapQLKhoa3]\r\n,[NoiDungPhuCapQLKhoa4]\r\n,[NoiDungPhuCapQLKhoa5]\r\n,[PhuCapCapUy]\r\n,[NgayHuongThamNienNhaGiao]\r\n,[GhiChuHoSo]\r\n,[ThongTinGhiChuHoSo]\r\n,[MaTinhTrangHoSo]\r\n,[BenhVienKham]\r\n,[HD_LaoDong]\r\n,[NamLuuHu]\r\n,[ThoiGianKetThuc]\r\n,[MaDanhHieu]\r\n,[NgayVaoBienChe]\r\n\r\n,[BienChe]\r\n,[NgayBatDauHD]\r\n,[NgayThamGiaBHXH]\r\n,[SoThangTru]\r\n,[NgayNangTNNGTiepTheo]\r\n,[GhiChuTNNG]\r\n,[IsPhucLoiTet]\r\n,[CoHuu]\r\n,[CongDoanVien]\r\n,IIF([CongDoanVien]=1, N'Công đoàn viên', N'') as [CongDoanVienText]\r\n,[NgayVaoCongDoan]\r\n,[MaCBGV]\r\n,[NgayVaoDangCT]\r\n,ns.[IsCapNhat]\r\n,[NgayHuongLuongCu]\r\n,[clsRun]\r\n,ns.[NgayImport]\r\n,ns.[USerImport]\r\n,[NgayCapHocHam_HocVi]\r\n,[NgayCapHocVi]\r\n,[MaBoMonKiemNhiem]\r\nFROM [HRM].[dbo].[NS_NHANSU] ns left join DM_CHUYENNGANH dm_cn on ns.CHUYENNGANH = dm_cn.MaChuyenNganh\r\nleft join DM_PhuongXa dm_px1 on ns.MaPhuongXa = dm_px1.MaPhuongXa\r\nleft join DM_QuanHuyen dm_qh1 on ns.QUAN_HUYEN = dm_qh1.MaQuanHuyen\r\nleft join DM_TinhThanhPho dm_ttp1 on ns.TINH_THANHPHO = dm_ttp1.MaTinhThanhPho\r\n\r\nleft join DM_PhuongXa dm_pxll on ns.MaPhuongXa_LienLac = dm_pxll.MaPhuongXa\r\nleft join DM_QuanHuyen dm_qhll on ns.QUAN_HUYEN_LienLac = dm_qhll.MaQuanHuyen\r\nleft join DM_TinhThanhPho dm_ttpll on ns.TINH_THANHPHO_LienLac = dm_ttpll.MaTinhThanhPho\r\n\r\nleft join DM_DanToc dm_dt on ns.DANTOC = dm_dt.MaDanToc\r\n\r\n\r\nleft join DM_QUOCTICH dm_qt on ns.QUOCTICH = dm_qt.MaQuocTich\r\nleft join DM_TONGIAO dm_tg on ns.TONGIAO = dm_tg.MaTonGiao\r\nleft join DM_HOCHAM dm_hh on ns.HOCHAM = dm_hh.MaHocHam\r\nleft join DM_HOCVI dm_hv on ns.HOCVI = dm_hv.MaHocVi\r\nleft join DM_DONVI dm_dv on ns.DONVI = dm_dv.MADONVI\r\nleft join DM_PHONGBAN dm_pb on ns.PHONGBAN = dm_pb.MAPHONGBAN\r\nleft join DM_TrinhDoHocVan dm_tdhv on ns.TRINHDOHOCVAN = dm_tdhv.MaTrinhDoHocVan\r\nleft join DM_ChinhTri dm_ct on ns.CHINHTRI = dm_ct.MaChinhTri\r\nleft join DM_ChucVu dm_cv on ns.CHUCVU = dm_cv.MaChucVu\r\nleft join DM_NganHang dm_nh on ns.NGANHANG = dm_nh.MaNganHang",
  "IdColumnName": "MA",
