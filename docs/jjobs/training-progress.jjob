{
  "ConnectionString": "Server=localhost;Database=HRM;Integrated Security=SSPI",
  "SqlQuery": "SELECT  [QuaTrinhBoiDuong]\r\n,ns.MA\r\n,[NgayBatDau]\r\n,[NgayKetThuc]\r\n,[NoiBoiDuong]\r\n,[NoiDung]\r\n,qtbd.[MaHinhThucDaoTao]\r\n,dm_htdt.TenHinhThucDaoTao\r\n,[DinhKemFile]\r\n,qtbd.[NhanSu]\r\n,[MaQTBD]\r\n,qtbd.[NGUOIDUNG2]\r\n,qtbd.[NGAY2]\r\n,qtbd.[MAY2]\r\n,qtbd.[IsCapNhat]\r\n,qtbd.[NGUOIDUNG1]\r\n,qtbd.[NGAY1]\r\n,qtbd.[MAY1]\r\n,qtbd.[UserImport]\r\n,qtbd.[NgayImport]\r\n,qtbd.[clsRun]\r\nFROM [HRM].[dbo].[NS_QuaTrinhBoiDuong] qtbd\r\nleft join DM_HinhThucDaoTao dm_htdt on qtbd.MaHinhThucDaoTao = dm_htdt.MaHinhThucDaoTao\r\nleft join NS_NHANSU ns on ns.NHANSU = qtbd.NhanSu\r\norder by QuaTrinhBoiDuong desc",
