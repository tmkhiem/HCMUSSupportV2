{
  "ConnectionString": "Server=localhost;Database=HRM;Integrated Security=SSPI",
  "SqlQuery": "SELECT  [QuaTrinhDaoTao]\r\n,qtdt.[NhanSu]\r\n,NS.MA\r\n,[NgayNhapHoc]\r\n,[CoSoDaoTao]\r\n,[NgayTotNghiep]\r\n,qtdt.[MaQuocTich]\r\n,dm_qt.TenQuocTich\r\n,qtdt.[MaLoaiBangCap]\r\n,dm_lbc.TenLoaiBangCap\r\n,[MaHinhThuc]\r\n,dm_htdt.TenHinhThucDaoTao\r\n,qtdt.[MaChuyenNganh]\r\n,dm_cn.TenChuyenNganh\r\n,[LuanAnTN]\r\n,[FileDinhKem]\r\n,qtdt.[NGUOIDUNG1]\r\n,qtdt.[NGAY1]\r\n,qtdt.[MAY1]\r\n,qtdt.[NGUOIDUNG2]\r\n,qtdt.[NGAY2]\r\n,qtdt.[MAY2]\r\n,[MaQTDT]\r\n,qtdt.[IsCapNhat]\r\n,qtdt.[GhiChu]\r\n,qtdt.[clsRun]\r\n,qtdt.[UserImport]\r\n,qtdt.[NgayImport]\r\nFROM [HRM].[dbo].[NS_QuaTrinhDaoTao] qtdt\r\nleft join DM_LoaiBangCap dm_lbc on  qtdt.MaLoaiBangCap = dm_lbc.MaLoaiBangCap\r\nleft join DM_HinhThucDaoTao dm_htdt on qtdt.MaHinhThuc = dm_htdt.MaHinhThucDaoTao\r\nleft join DM_ChuyenNganh dm_cn on qtdt.MaChuyenNganh = dm_cn.MaChuyenNganh\r\nleft join DM_QuocTich dm_qt on qtdt.MaQuocTich = dm_qt.TenQuocTich\r\nleft join NS_NHANSU ns on ns.NHANSU = qtdt.NhanSu\r\norder by QuaTrinhDaoTao desc",
  "IdColumnName": "MA",
  "Header": "{TenLoaiBangCap} {TenChuyenNganh}",
  "Template": "<ul>\r\n<li>\r\n{TenLoaiBangCap} {TenChuyenNganh}\r\n</li>\r\n<li>\r\nNgày nhập học: {NgayNhapHoc}\r\n</li>\r\n<li>\r\nNgày tốt nghiệp: {NgayTotNghiep}\r\n</li>\r\n<li>\r\nCơ sở đào tạo: {CoSoDaoTao}\r\n</li>\r\n<li>\r\nNước cấp bằng: {TenQuocTich}\r\n</li>\r\n<li>\r\nHình thức đào tạo: {TenHinhThucDaoTao}\r\n</li>\r\n<li>\r\nTên khóa luận/đề tài tốt nghiệp/luận văn/luận án: {LuanAnTN}\r\n</li>\r\n</ul>",
