# /etc/hcmus-support/env - environment for hcmus-support.service (root:hcmus-support, mode 0640).
# server-bootstrap.sh creates this file ONCE from this template (it never overwrites an existing one).
# Rules: one KEY=VALUE per line, keep values double-quoted, no secrets in git.
# ASP.NET Core maps "__" to ":" in configuration keys (ConnectionStrings__Default = ConnectionStrings:Default).
#
# !! The key names below must match what the final backend reads (appsettings.json of HCMUSSupportV2.Backend).
# !! Double-check them against the merged D01/D03/D06 code before the first deploy (OPERATIONS.md section 3).

# --- Database (filled in by server-bootstrap.sh) ---
ConnectionStrings__Default="__CONNECTION_STRING__"

# --- Google sign-in (Q7: reuse the v1 web client; add https://support.hcmus.edu.vn/api/auth/callback in Cloud Console) ---
#Authentication__Google__ClientId="..."
#Authentication__Google__ClientSecret="..."

# --- File store (default location; the unit only allows writes under /var/lib/hcmus-support) ---
#Files__RootPath="/var/lib/hcmus-support/files"

# --- Reverse proxy: nginx is on loopback, which ASP.NET Core trusts by default. Only set these if that changes. ---
#ReverseProxy__KnownProxies__0="127.0.0.1"

# --- Logging ---
#Serilog__MinimumLevel__Default="Information"

# --- Optional OpenTelemetry export ---
#OTEL_EXPORTER_OTLP_ENDPOINT="http://127.0.0.1:4317"
