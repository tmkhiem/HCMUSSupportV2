# HCMUS Support V2 - ASP.NET Core 8 app (serves the Vite SPA from wwwroot and /api).
# Install to /etc/systemd/system/hcmus-support.service (server-bootstrap.sh does this).
#
# Layout:  /opt/hcmus-support/app  ->  symlink to /opt/hcmus-support/releases/<timestamp>
# Secrets: /etc/hcmus-support/env  (root:hcmus-support 0640, never in the repo; template: deploy/env.example)
[Unit]
Description=HCMUS Support V2 (ASP.NET Core)
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service
# Keep trying after a bad deploy or a database restart, but stop a hot crash loop eventually.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=hcmus-support
Group=hcmus-support
WorkingDirectory=/opt/hcmus-support/app

Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5080
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=DOTNET_NOLOGO=1
Environment=DOTNET_gcServer=0
# Values in the env file override the Environment= lines above.
EnvironmentFile=/etc/hcmus-support/env

ExecStart=/usr/bin/dotnet /opt/hcmus-support/app/HCMUSSupportV2.Backend.dll

Restart=always
RestartSec=5
TimeoutStartSec=90
# SSE streams and in-flight requests get this long to drain on stop/restart.
TimeoutStopSec=30

# Logging: console output goes to journald (Serilog console sink). `journalctl -u hcmus-support`
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hcmus-support

LimitNOFILE=65536
UMask=0027

# Hardening. MemoryDenyWriteExecute is deliberately NOT set: the .NET JIT needs W+X pages.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
# The only writable locations: uploaded files + the rolling log file.
ReadWritePaths=/var/lib/hcmus-support /var/log/hcmus-support

[Install]
WantedBy=multi-user.target
