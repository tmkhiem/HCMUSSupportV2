{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Logging": {
    "File": {
      "Enabled": true,
      "Path": "logs/hcmus-support-.log",
      "RetainedFiles": 30
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "ReverseProxy": {
    "KnownNetworks": [],
    "KnownProxies": []
  },
  "Storage": {
    "LocalRoot": "App_Data/files",
    "MaxBytes": 26214400,
    "AllowedContentTypes": [
      "image/*",
      "application/pdf",
      "text/plain",
      "text/csv",
      "application/msword",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "application/vnd.ms-excel",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
    ]
  },
  "Jobs": {
    "Enabled": true,
    "WorkerCount": 1,
    "PollIntervalMs": 2000,
    "LeaseSeconds": 300,
    "BackoffBaseSeconds": 10,
    "BackoffMaxSeconds": 3600
  },
  "RateLimiting": {
    "Auth": { "PermitLimit": 20, "WindowSeconds": 60 },
    "Integration": { "PermitLimit": 600, "WindowSeconds": 60 }
  },
  "OpenTelemetry": {
    "ServiceName": "hcmus-support",
    "Endpoint": "",
    "Protocol": "grpc"
  }
}
