# /etc/hcmus-support/env - environment for hcmus-support.service (root:hcmus-support, mode 0640).
# server-bootstrap.sh creates this file ONCE from this template (it never overwrites an existing one) and fills in
# the database line below. Edit the live file afterwards, then: sudo systemctl restart hcmus-support
#
# Rules: one KEY=VALUE per line, values double-quoted, no secrets in git (placeholders only here).
# ASP.NET Core maps "__" to ":" (Auth__Google__ClientId = Auth:Google:ClientId); array items use an index
# (Admin__BootstrapEmails__0). Keys are read from HCMUSSupportV2.Backend/appsettings.json and the *Options classes;
# docs/BACKEND.md section "Configure a dev machine" lists them with their meaning. Environment variables win over appsettings.json.
# Lines starting with "#" are optional: the value shown is the built-in default unless the comment says otherwise.
# The unit sets ASPNETCORE_ENVIRONMENT=Production and ASPNETCORE_URLS=http://127.0.0.1:5080 itself.

# =====================================================================================================
# REQUIRED
# =====================================================================================================

# --- Database (filled in by server-bootstrap.sh; also used by activate.sh for the migrations bundle) ---
ConnectionStrings__Default="__CONNECTION_STRING__"

# --- Google sign-in (Q7: reuse the v1 web client; add https://support.hcmus.edu.vn/api/auth/callback to its redirect URIs).
#     Without both values GET /api/auth/login answers 503. ---
Auth__Google__ClientId="<google-oauth-client-id>"
Auth__Google__ClientSecret="<google-oauth-client-secret>"

# --- First administrator(s): emails that become admin while the database has no active admin and the email maps to an
#     employee (checked at startup and at each sign-in). Once an admin exists this is ignored. Add _1, _2, ... for more. ---
Admin__BootstrapEmails__0="<first-admin>@hcmus.edu.vn"

# --- Paths. The defaults are relative to the app directory (/opt/hcmus-support/app), which the unit makes read-only
#     (ProtectSystem=strict), so these two MUST point into the writable paths of the unit. ---
Storage__LocalRoot="/var/lib/hcmus-support/files"
Logging__File__Path="/var/log/hcmus-support/hcmus-support-.log"

# =====================================================================================================
# OPTIONAL
# =====================================================================================================

# --- Database ---
# Apply EF migrations when the app starts. Default false in Production (activate.sh runs the migrations bundle instead).
#Database__MigrateOnStartup="false"

# --- Reverse proxy: nginx is on loopback, which ASP.NET Core trusts by default. Only set these if that changes. ---
#ReverseProxy__KnownProxies__0="127.0.0.1"
#ReverseProxy__KnownNetworks__0="10.0.0.0/8"

# --- Sign-in session ---
# Seconds between re-checks of the session against the database (employee still active, current roles); 0 = every request.
#Auth__RevalidateSeconds="300"
# Minutes before an admin "view as" session ends by itself.
#Admin__ViewAs__Minutes="60"

# --- File store limits ---
#Storage__MaxBytes="26214400"
# Allowed MIME types (exact or type/*); the default list is in appsettings.json. An empty list means no restriction.
#Storage__AllowedContentTypes__0="image/*"

# --- Background jobs (the worker also sends notifications) ---
#Jobs__Enabled="true"
#Jobs__WorkerCount="1"
#Jobs__PollIntervalMs="2000"
#Jobs__LeaseSeconds="300"
#Jobs__BackoffBaseSeconds="10"
#Jobs__BackoffMaxSeconds="3600"

# --- Notifications ---
# Live push (SSE + the LISTEN connection). Off in v2.0 by design: employees reload to see new notifications.
#Notifications__Realtime__Enabled="false"
#Notifications__Scheduler__PollSeconds="30"
#Notifications__Sse__HeartbeatSeconds="25"
#Notifications__Listener__Enabled="true"

# --- Rate limits per client IP (fixed window) ---
#RateLimiting__Auth__PermitLimit="20"
#RateLimiting__Auth__WindowSeconds="60"
#RateLimiting__Integration__PermitLimit="600"
#RateLimiting__Integration__WindowSeconds="60"

# --- Logging: console goes to journald; the rolling file is Logging__File__Path above ---
#Serilog__MinimumLevel__Default="Information"
#Logging__File__Enabled="true"
#Logging__File__RetainedFiles="30"

# --- OpenTelemetry: traces and metrics are exported only when Endpoint is set (OTLP collector URL) ---
#OpenTelemetry__Endpoint="http://127.0.0.1:4317"
#OpenTelemetry__Protocol="grpc"
#OpenTelemetry__ServiceName="hcmus-support"

# =====================================================================================================
# NOT FOR PRODUCTION (Development only; the backend ignores or 404s them elsewhere - do not set on the server)
#   Auth__DevLogin__Enabled, Dev__SeedEmployees, Hrm__DevApiClient__Token
# The Sync tool (HCMUSSupportV2.Sync) runs on the HRM machine, not here, and has its own settings:
#   Sync__ApiBaseUrl, Sync__ApiToken, Sync__HrmConnectionString, Sync__TimeoutSeconds  (see docs/SYNC.md)
# =====================================================================================================
