{
  "ConnectionString": "Server=localhost;Database=HRM;Integrated Security=SSPI",
  "SqlQuery": "SELECT TOP (1000) [QuaTrinhCongTac]\r\n,ns.MA as MaNhanSu\r\n,ns.hodem, ns.ten\r\n,qtct.*\r\nFROM [HRM].[dbo].[NS_QuaTrinhCongTac] qtct join ns_nhansu ns on qtct.NhanSu = ns.NHANSU\r\nwhere ns.MA = '0300'\r\norder by qtct.[QuaTrinhCongTac] desc",
  "IdColumnName": "MaNhanSu",
