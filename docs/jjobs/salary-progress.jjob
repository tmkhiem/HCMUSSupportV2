{
  "ConnectionString": "Server=localhost;Database=HRM;Integrated Security=SSPI",
  "SqlQuery": "SELECT [QuaTrinhLuong] as QuaTrinhLuongID\r\n\t  ,ns.MA as MaNhanSu\r\n      ,ns.hodem, ns.ten\r\n      ,ns.Ngach_CongChuc as Ngach_CongChucHienTai\r\n      ,ns.BacCongChuc as BacCongChucHienTai\r\n      ,ns.HeSoLuong as HeSoLuongHienTai\r\n\t  ,qtl.*\r\n  FROM [HRM].[dbo].[NS_QuaTrinhLuong] qtl join ns_nhansu ns on qtl.NhanSu = ns.NHANSU\r\n  order by QuaTrinhLuongID desc",
  "IdColumnName": "MaNhanSu",
